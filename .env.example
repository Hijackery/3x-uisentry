# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# ID администраторов через запятую. Только у них будут кнопки обслуживания.
TELEGRAM_ADMIN_IDS=11111111,22222222
# Куда слать алерты. Пусто = администраторам из TELEGRAM_ADMIN_IDS.
ALERT_CHAT_ID=
# Bot API: свой сервер или прокси (по умолчанию https://api.telegram.org).
TELEGRAM_API_URL=https://api.telegram.org

# --- Панель 3X-UI ---
# Адрес панели. Если в панели задан webBasePath, укажите и его.
PANEL_URL=https://vps.example.com:2053
PANEL_BASE_PATH=
# API-токен панели. Создаётся в панели (Settings → API Tokens) или так:
#   sudo x-ui setting -getApiToken true -tokenName monitor-bot -tokenScope node-sync
# node-sync нужен, чтобы видеть inbound'ы и подписки; monitor даёт
# только статус и метрики. admin не требуется.
PANEL_API_TOKEN=
PANEL_VERIFY_TLS=true
# Свой CA-файл (PEM) для проверки панели. Если задан — используется вместо
# PANEL_VERIFY_TLS: удобно для пиннинга самоподписанного сертификата.
PANEL_CA_BUNDLE=
PANEL_TIMEOUT=15

# --- Наблюдение ---
# systemd-юниты под наблюдением
SERVICES=x-ui,fail2ban
DISK_PATH=/

# --- Пороги алертов (проценты) ---
CPU_WARN=80
CPU_CRIT=95
MEM_WARN=85
MEM_CRIT=95
DISK_WARN=85
DISK_CRIT=93
# Гистерезис: состояние держится, пока метрика не опустится ниже порога на столько.
ALERT_HYSTERESIS=5
# Как часто переотправлять одно и то же активное нарушение, секунд.
ALERT_COOLDOWN=1800
# Через сколько дней считать подписку «скоро истекает».
EXPIRING_SOON_DAYS=3

# --- Периодичность и безопасность ---
CHECK_INTERVAL=60
# Пауза между одинаковыми действиями (защита от случайного спама кнопок), секунд.
ACTION_COOLDOWN=30
# Сколько живёт кнопка подтверждения, секунд.
CONFIRM_TTL=120
# Таймаут долгих команд вроде apt full-upgrade, секунд.
COMMAND_TIMEOUT=900

# --- Произвольные команды ---
# Список должен совпадать с белым списком в install/uisentry-ctl (case run_command).
# Если список пуст, произвольные команды недоступны.
COMMAND_ALLOWLIST=os_logs,os_errors,kernel_logs,xui_logs,dmesg,sockets,net_summary,addresses,routes,failed_units,xui_service,uname,top_cpu,log_size,inodes,upgradable,upgrade_sim,vmstat,time_status,logged_in,boot_time,cpu_info,block_devices,journalctl --disk-usage,systemctl list-timers --all,free -h,df -h,uptime,x-ui status

# --- Пути ---
STATE_PATH=/var/lib/uisentry/state.db
LOG_PATH=/var/lib/uisentry/bot.log
LOG_LEVEL=INFO
SUDO_WRAPPER=/usr/local/bin/uisentry-ctl
