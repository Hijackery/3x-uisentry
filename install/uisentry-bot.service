[Unit]
Description=3X-UI Sentry — Telegram monitor bot
After=network-online.target x-ui.service
Wants=network-online.target

[Service]
Type=simple
User=uisentry
Group=uisentry
WorkingDirectory=/opt/uisentry
EnvironmentFile=/opt/uisentry/.env
# Каталог состояния создаёт systemd с нужным владельцем: база и логи лежат
# вне каталога с кодом, поэтому бот не может переписать сам себя.
StateDirectory=uisentry
StateDirectoryMode=0750
# Без unbuffered логи в journalctl появляются с задержкой в несколько минут.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/uisentry/.venv/bin/python -m uisentry
SyslogIdentifier=uisentry-bot
Restart=always
RestartSec=10
TimeoutStopSec=30

# Всё, кроме каталога состояния, только для чтения.
ProtectSystem=strict
ReadWritePaths=/var/lib/uisentry
ProtectHome=true
PrivateTmp=true
# Бот не должен видеть устройства, часы, hostname и чужие процессы.
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
# ProtectProc скрывает чужие процессы, но /proc/stat, /proc/meminfo и /proc/net
# остаются на месте — psutil без них не может собрать метрики. Директиву
# ProcSubset здесь ставить нельзя: она монтирует /proc только с PID-информацией.
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# AF_NETLINK нужен glibc для проверки интерфейсов при резолве DNS.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# База и лог создаются с правами 0600, даже если umask в системе мягкий.
UMask=0077
# NoNewPrivileges намеренно не включён: иначе sudo (setuid root) не сможет
# получить права, и привилегированные операции бота перестанут работать.
RestrictSUIDSGID=false

# Умеренные ограничения памяти: при утечке бот не утащит за собой сервер.
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
