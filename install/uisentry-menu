#!/usr/bin/env bash
#
# uisentry-menu — консольная панель 3X-UI Sentry.
#
# Запуск:  sudo uisentry-menu            # интерактивное меню
#          sudo uisentry-menu status     # состояние службы
#          sudo uisentry-menu show       # настройки (секреты замаскированы)
#          sudo uisentry-menu keys       # какие ключи можно менять
#          sudo uisentry-menu set PANEL_TIMEOUT 20
#          uisentry-menu check PANEL_TIMEOUT 20   # проверка без изменений (без root)
#          sudo uisentry-menu restart | logs [N] | update | uninstall [--purge]
#
# Меню меняет только ключи из белого списка, пишет .env атомарно с правами
# 640 root:<сервисный пользователь> и перезапускает службу по подтверждению.
set -euo pipefail

PREFIX="${PREFIX:-/opt/uisentry}"
ENV_FILE="${ENV_FILE:-$PREFIX/.env}"
SERVICE_NAME="${SERVICE_NAME:-uisentry-bot}"
SERVICE_USER="${SERVICE_USER:-uisentry}"
REPO_URL="${REPO_URL:-https://github.com/Hijackery/3x-uisentry}"
REPO_REF="${REPO_REF:-main}"

# Ответы читаем с терминала: меню может быть запущено и через пайп.
READ_FD=0
if [ ! -t 0 ] && { exec 3</dev/tty; } 2>/dev/null; then
    READ_FD=3
fi

BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
YELLOW=$'\033[33m'; BLUE=$'\033[34m'; RESET=$'\033[0m'
if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ]; then
    BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; RESET=""
fi

# --- оформление меню ------------------------------------------------------
# Рамка рисуется по самой длинной строке, чтобы ничего не разъезжалось. Ширину
# считаем по видимому тексту (ANSI-последовательности выкидываем).
strip_ansi() { printf '%s' "$1" | sed -E $'s/\x1b\\[[0-9;]*m//g'; }
vis_len() { local t; t="$(strip_ansi "$1")"; printf '%s' "${#t}"; }
repeat_char() {
    local out=""
    printf -v out '%*s' "$1" ''
    printf '%s' "${out// /$2}"
}

# Пункты меню: g|заголовок группы, s|разделитель, ЧИСЛО|подпись.
MENU_ROWS=(
    "g|Диагностика"
    "1|Состояние службы и последние ошибки"
    "2|Показать настройки (секреты замаскированы)"
    "3|Журнал бота (последние 50 строк)"
    "s|"
    "g|Telegram"
    "4|Токен бота (@BotFather)"
    "5|ID администраторов"
    "6|Чат для алертов"
    "s|"
    "g|Панель 3X-UI"
    "7|Адрес панели (PANEL_URL)"
    "8|webBasePath (PANEL_BASE_PATH)"
    "9|API-токен панели"
    "10|Проверка TLS и CA-сертификат"
    "s|"
    "g|Пороги и алерты"
    "11|Загрузка CPU (предупреждение/критично)"
    "12|Память (предупреждение/критично)"
    "13|Диск (предупреждение/критично)"
    "14|Гистерезис и кулдаун"
    "15|За сколько дней предупреждать о подписке"
    "s|"
    "g|Обслуживание"
    "16|Службы под наблюдением"
    "17|Уровень логирования"
    "18|Изменить любой ключ по имени"
    "19|Перезапустить бота"
    "20|Перезапустить xray в панели"
    "21|Обновить бота с GitHub"
    "s|"
    "22|Удалить бота"
    "0|Выход"
)

menu_max() {
    local spec n max=0
    for spec in "${MENU_ROWS[@]}"; do
        case "$spec" in
            g\|*|s\|*) continue ;;
        esac
        n="${spec%%|*}"
        (( n > max )) && max=$n
    done
    printf '%s' "$max"
}

draw_menu() {
    local status="$1" title="3X-UI Sentry — панель управления"
    local -a rows=("$title" "$status") kinds=("title" "status")
    local spec kind payload
    for spec in "${MENU_ROWS[@]}"; do
        kind="${spec%%|*}"; payload="${spec#*|}"
        case "$kind" in
            g) rows+=("  $payload"); kinds+=("group") ;;
            s) rows+=(""); kinds+=("sep") ;;
            *) rows+=("$(printf '  %2s. %s' "$kind" "$payload")"); kinds+=("item") ;;
        esac
    done

    local w=0 r lw
    for r in "${rows[@]}"; do lw="$(vis_len "$r")"; (( lw > w )) && w=$lw; done
    (( w < 54 )) && w=54
    local inner=$(( w + 2 ))

    printf '\n%s%s%s\n' "$BLUE" "╔$(repeat_char "$inner" '═')╗" "$RESET"
    local i row text pad
    for i in "${!rows[@]}"; do
        row="${rows[$i]}"; kind="${kinds[$i]}"
        if [ "$kind" = "sep" ]; then
            printf '%s%s%s\n' "$BLUE" "│$(repeat_char "$inner" '─')│" "$RESET"
            continue
        fi
        case "$kind" in
            title)
                text="$BOLD$row$RESET"
                pad=$(( (w - $(vis_len "$row")) / 2 ))
                ;;
            group) text="$BOLD$row$RESET"; pad=0 ;;
            status) text=" $row"; pad=0 ;;
            *) text="$row"; pad=0 ;;
        esac
        local fill=$(( w - pad - $(vis_len "$row") ))
        (( fill < 0 )) && fill=0
        printf '%s│%s %s%s%s %s│%s\n' \
            "$BLUE" "$RESET" "$(repeat_char "$pad" ' ')" "$text" \
            "$(repeat_char "$fill" ' ')" "$BLUE" "$RESET"
    done
    printf '%s%s%s\n' "$BLUE" "╚$(repeat_char "$inner" '═')╝" "$RESET"
}

menu_status_line() {
    local st="неизвестно" color="$DIM"
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
            st="работает"; color="$GREEN"
        else
            st="остановлена"; color="$RED"
        fi
    elif command -v rc-service >/dev/null 2>&1; then
        st="OpenRC"; color="$DIM"
    fi
    printf 'Служба %s: %s●%s %s' "$SERVICE_NAME" "$color" "$RESET" "$st"
}


ok()   { printf '      %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
info() { printf '      %s\n' "$1"; }
warn() { printf '      %s!%s %s\n' "$YELLOW" "$RESET" "$1"; }
die()  { printf '%s✗ %s%s\n' "$RED" "$1" "$RESET" >&2; exit 1; }
head1(){ printf '\n%s%s%s\n' "$BOLD$BLUE" "$1" "$RESET"; }

need_root() {
    [ "$(id -u)" -eq 0 ] || die "Нужен root: sudo uisentry-menu $*"
}

need_env() {
    [ -f "$ENV_FILE" ] || die "Не найден $ENV_FILE — бот установлен?"
}

#: Ключи, которые безопасно менять из меню (значения проверяются ниже).
EDITABLE_KEYS=(
    TELEGRAM_BOT_TOKEN TELEGRAM_ADMIN_IDS ALERT_CHAT_ID TELEGRAM_API_URL
    PANEL_URL PANEL_BASE_PATH PANEL_API_TOKEN PANEL_VERIFY_TLS PANEL_CA_BUNDLE
    SERVICES DISK_PATH PANEL_TIMEOUT
    CPU_WARN CPU_CRIT MEM_WARN MEM_CRIT DISK_WARN DISK_CRIT
    ALERT_HYSTERESIS ALERT_COOLDOWN EXPIRING_SOON_DAYS
    CHECK_INTERVAL ACTION_COOLDOWN CONFIRM_TTL COMMAND_TIMEOUT
    COMMAND_ALLOWLIST LOG_LEVEL
)

#: Разумные подсказки для пошагового изменения.
declare -A KEY_HINT=(
    [TELEGRAM_BOT_TOKEN]="токен от @BotFather (вид 123456:AA...)"
    [TELEGRAM_ADMIN_IDS]="ID администраторов через запятую"
    [ALERT_CHAT_ID]="ID чата для алертов (число, у групп отрицательное) или пусто — тогда админам в личку"
    [PANEL_URL]="адрес панели, например https://panel.example.com:2053"
    [PANEL_BASE_PATH]="webBasePath панели (пусто, если не задан)"
    [PANEL_API_TOKEN]="токен панели со scope node-sync"
    [SERVICES]="юниты под наблюдением, через запятую"
    [LOG_LEVEL]="DEBUG, INFO, WARNING или ERROR"
)

is_editable() {
    local key="$1" known
    for known in "${EDITABLE_KEYS[@]}"; do
        [ "$known" = "$key" ] && return 0
    done
    return 1
}

# check_value KEY VALUE — проверяет значение и печатает причину отказа.
check_value() {
    local key="$1" value="$2"
    case "$key" in
        TELEGRAM_BOT_TOKEN)
            case "$value" in
                *:*) ;;
                *) die "токен @BotFather выглядит как 123456:AA... — проверьте вставку" ;;
            esac
            ;;
        TELEGRAM_ADMIN_IDS)
            printf '%s' "$value" | grep -qE '^[0-9]+(,[0-9]+)*$' \
                || die "ID должны быть числами через запятую"
            ;;
        TELEGRAM_API_URL|PANEL_URL)
            case "$value" in
                http://*|https://*) ;;
                *) die "$key должен начинаться с http:// или https://" ;;
            esac
            ;;
        CPU_WARN|CPU_CRIT|MEM_WARN|MEM_CRIT|DISK_WARN|DISK_CRIT|ALERT_HYSTERESIS|PANEL_TIMEOUT)
            printf '%s' "$value" | grep -qE '^[0-9]+([.][0-9]+)?$' \
                || die "$key — это процент, например 85"
            ;;
        ALERT_CHAT_ID)
            # У групп и каналов ID отрицательный; пусто — алерты в личку.
            [ -z "$value" ] || printf '%s' "$value" | grep -qE '^-?[0-9]+$' \
                || die "ALERT_CHAT_ID — целое число (у групп отрицательное)"
            ;;
        ALERT_COOLDOWN|EXPIRING_SOON_DAYS|CHECK_INTERVAL|ACTION_COOLDOWN|CONFIRM_TTL|COMMAND_TIMEOUT)
            printf '%s' "$value" | grep -qE '^[0-9]+$' || die "$key — целое число"
            ;;
        PANEL_VERIFY_TLS)
            case "$value" in
                true|false) ;;
                *) die "PANEL_VERIFY_TLS: true или false" ;;
            esac
            ;;
        LOG_LEVEL)
            case "$value" in
                DEBUG|INFO|WARNING|ERROR) ;;
                *) die "LOG_LEVEL: DEBUG, INFO, WARNING или ERROR" ;;
            esac
            ;;
    esac
    return 0
}

show_setting() {
    local key="$1" value
    value="$(sed -n "s/^${key}=//p" "$ENV_FILE" 2>/dev/null | head -1)"
    case "$key" in
        TELEGRAM_BOT_TOKEN|PANEL_API_TOKEN)
            # Короткое значение маскируем целиком: иначе «первые 6 + последние 4»
            # покажут почти весь секрет.
            if [ -z "$value" ]; then
                printf '  %-22s %s\n' "$key" "(пусто)"
            elif [ "${#value}" -lt 12 ]; then
                printf '  %-22s *** (%d символов)\n' "$key" "${#value}"
            else
                printf '  %-22s %s ···%s\n' "$key" "${value:0:6}" "${value: -4}"
            fi
            ;;
        *)
            printf '  %-22s %s\n' "$key" "${value:-—}"
            ;;
    esac
}

cmd_show() {
    need_env
    head1 "Настройки бота ($ENV_FILE)"
    local key
    for key in "${EDITABLE_KEYS[@]}"; do
        show_setting "$key"
    done
    info "Секреты показаны замаскированными. Изменить: sudo uisentry-menu set KEY VALUE"
}

cmd_keys() {
    printf '%s\n' "${EDITABLE_KEYS[@]}"
}

cmd_check() {
    local key="${1:-}" value="${2:-}"
    [ -n "$key" ] || die "check: укажите ключ и значение"
    is_editable "$key" || die "ключ $key менять нельзя (см. uisentry-menu keys)"
    check_value "$key" "$value"
    case "$key" in
        TELEGRAM_BOT_TOKEN | PANEL_API_TOKEN)
            ok "$key: значение корректно (скрыто, ${#value} символов)"
            ;;
        *)
            ok "$key=$value — значение корректно"
            ;;
    esac
}

cmd_set() {
    local key="${1:-}" value="${2:-}"
    need_root "set"
    need_env
    [ -n "$key" ] || die "set: укажите ключ и значение"
    is_editable "$key" || die "ключ $key менять нельзя (см. uisentry-menu keys)"
    # Приводим адрес и путь к каноническому виду: без пробелов и лишних слешей,
    # иначе бот получит «https://host:5580//» и панель ответит 404.
    case "$key" in
        PANEL_URL | TELEGRAM_API_URL)
            value="$(printf '%s' "$value" | tr -d '[:space:]' | sed -E 's#/*$##')"
            ;;
        PANEL_BASE_PATH)
            value="$(printf '%s' "$value" | tr -d '[:space:]' | sed -E 's#^/*##; s#/*$##')"
            ;;
    esac
    check_value "$key" "$value"
    case "$value" in
        *$'\n'*) die "значение не должно содержать перевод строки" ;;
    esac

    id "$SERVICE_USER" >/dev/null 2>&1 \
        || die "нет системного пользователя $SERVICE_USER (переустановите бота)"

    local tmp="$ENV_FILE.tmp.$$"
    grep -vE "^${key}=" "$ENV_FILE" >"$tmp" 2>/dev/null || true
    printf '%s=%s\n' "$key" "$value" >>"$tmp"
    install -o root -g "$(id -gn "$SERVICE_USER" 2>/dev/null || printf '%s' "$SERVICE_USER")" \
        -m 0640 "$tmp" "$ENV_FILE"
    rm -f "$tmp"
    ok "$key обновлён"
    info "Применится после перезапуска: sudo uisentry-menu restart"
}

cmd_status() {
    head1 "Служба $SERVICE_NAME"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl status "$SERVICE_NAME" --no-pager 2>&1 | head -12 | sed 's/^/  /'
    else
        warn "systemctl не найден"
    fi
    if [ -f "$ENV_FILE" ]; then
        head1 "Последние ошибки в журнале"
        journalctl -u "$SERVICE_NAME" -p warning -n 10 --no-pager 2>&1 | sed 's/^/  /' \
            || true
    fi
}

cmd_logs() {
    local lines="${1:-50}"
    case "$lines" in (*[!0-9]*) die "logs: число строк" ;; esac
    journalctl -u "$SERVICE_NAME" -n "$lines" --no-pager
}

cmd_restart() {
    need_root "restart"
    command -v systemctl >/dev/null 2>&1 || die "systemctl не найден"
    systemctl restart "$SERVICE_NAME"
    sleep 2
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        ok "$SERVICE_NAME перезапущен и работает"
    else
        warn "служба не активна, смотрите: journalctl -u $SERVICE_NAME -n 30"
        exit 1
    fi
}

cmd_update() {
    need_root "update"
    # Сначала пробуем свежий установщик из main: локальная копия в PREFIX — это
    # версия, которая ставила бота, и она сама себя не обновит.
    # Переменная глобальная: trap EXIT срабатывает уже после выхода из функции,
    # и local там был бы unbound (set -u).
    local slug=""
    installer=""
    if command -v curl >/dev/null 2>&1; then
        slug="$(printf '%s' "$REPO_URL" | sed -E 's#.*github\.com/##; s#\.git$##')"
        info "Скачиваю установщик: $slug@$REPO_REF"
        installer="$(mktemp)"
        _auth=()
        _gh_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
        [ -n "$_gh_token" ] && _auth=(-H "Authorization: Bearer $_gh_token")
        if curl -fsSL --max-time 60 "${_auth[@]}" \
            "https://raw.githubusercontent.com/${slug}/${REPO_REF}/install.sh" \
            -o "$installer"; then
            trap 'rm -f "${installer:-}"' EXIT
        else
            warn "не удалось скачать установщик, беру локальную копию"
            rm -f "$installer"
            installer=""
        fi
    fi
    if [ -z "$installer" ]; then
        for candidate in "$PREFIX/install.sh" "$PWD/install.sh"; do
            [ -f "$candidate" ] && installer="$candidate" && break
        done
    fi
    [ -n "$installer" ] || die "не найден install.sh и нет curl"

    info "Запускаю установщик (он же выполняет обновление)"
    local prefix="$PREFIX"
    PREFIX="$prefix" bash "$installer" --prefix "$prefix"
}

cmd_uninstall() {
    need_root "uninstall"
    local purge="${1:-}"
    local installer="$PREFIX/install.sh"
    [ -f "$installer" ] || installer="$PWD/install.sh"
    [ -f "$installer" ] || die "не найден install.sh"
    if [ "$purge" = "--keep-state" ]; then
        bash "$installer" --uninstall --keep-state --yes
    else
        bash "$installer" --uninstall --yes
    fi
}

ask() { printf '      %s' "$1"; }

ask_value() {
    # ask_value ПЕРЕМЕННАЯ "подсказка" "текущее"
    local var="$1" prompt="$2" current="$3" answer=""
    ask "$prompt"
    [ -n "$current" ] && printf ' %s[%s]%s' "$DIM" "$current" "$RESET"
    printf ' '
    read -r answer <&$READ_FD || answer=""
    printf -v "$var" '%s' "${answer:-$current}"
}

menu_edit_key() {
    local key="$1"
    need_root "set"
    need_env
    local current hint
    current="$(sed -n "s/^${key}=//p" "$ENV_FILE" | head -1)"
    hint="${KEY_HINT[$key]:-новое значение}"
    info "$key — $hint"
    local value=""
    ask_value value "Значение:" "$current"
    cmd_set "$key" "$value"
    local answer=""
    ask "Перезапустить бота сейчас? [Y/n] "
    read -r answer <&$READ_FD || answer=""
    case "$answer" in
        n|N|no|нет) info "Перезапуск отложен" ;;
        *) cmd_restart ;;
    esac
}

menu_pick() {
    # menu_pick "заголовок" KEY1 KEY2 … — подменю выбора ключа.
    local title="$1" ; shift
    local -a keys=("$@")
    head1 "$title"
    local i=1 k
    for k in "${keys[@]}"; do
        printf '  %d) %s\n' "$i" "$k"
        i=$(( i + 1 ))
    done
    ask "Номер (Enter — назад): "
    local pick=""
    read -r pick <&$READ_FD || pick=""
    case "$pick" in
        ""|0) return 0 ;;
        *[!0-9]*) warn "нужно число"; return 0 ;;
    esac
    if (( pick < 1 || pick > ${#keys[@]} )); then
        warn "нет такого пункта"
        return 0
    fi
    menu_edit_key "${keys[$(( pick - 1 ))]}"
}

cmd_totp() {
    need_root "totp"
    need_env
    local secret required
    secret="$(sed -n 's/^TOTP_SECRET=//p' "$ENV_FILE" | head -1)"
    required="$(sed -n 's/^TOTP_REQUIRED=//p' "$ENV_FILE" | head -1)"
    if [ -z "$secret" ]; then
        info "TOTP_SECRET пуст. Включить: sudo bash install.sh --2fa"
        return 0
    fi
    printf 'TOTP_REQUIRED=%s\n' "${required:-0}"
    printf 'TOTP secret: %s\n' "$secret"
    printf 'otpauth: otpauth://totp/3X-UI%%20Sentry:admin?secret=%s&issuer=3X-UI%%20Sentry\n' "$secret"
}

cmd_apt_logs() {
    need_root "apt-logs"
    local lines="${1:-80}"
    case "$lines" in (*[!0-9]*) die "apt-logs: число строк" ;; esac
    if ! command -v journalctl >/dev/null 2>&1; then
        local log
        for log in "${STATE_DIR:-/var/lib/uisentry}"/apt-*.log; do
            [ -f "$log" ] || continue
            printf '\n== %s ==\n' "$(basename "$log")"
            tail -n "$lines" "$log" 2>/dev/null || true
        done
        return 0
    fi
    local unit
    for unit in \
        uisentry-apt-update \
        uisentry-apt-upgrade \
        uisentry-apt-phased \
        uisentry-release-upgrade; do
        printf '\n== %s ==\n' "$unit"
        journalctl -u "$unit" -n "$lines" --no-pager 2>/dev/null \
            || printf '  (журнала нет)\n'
    done
}

cmd_restart_xray() {
    need_root "restart-xray"
    need_env
    local url base token api code
    url="$(sed -n 's/^PANEL_URL=//p' "$ENV_FILE" | head -1)"
    base="$(sed -n 's/^PANEL_BASE_PATH=//p' "$ENV_FILE" | head -1)"
    token="$(sed -n 's/^PANEL_API_TOKEN=//p' "$ENV_FILE" | head -1)"
    if [ -z "$url" ] || [ -z "$token" ]; then
        die "в .env нет PANEL_URL или PANEL_API_TOKEN"
    fi
    api="$url"
    [ -n "$base" ] && api="$url/${base#/}"
    api="${api%/}/panel/api"
    info "Запрос к панели: POST $api/server/restartXrayService"
    code="$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' -X POST \
        -H "Authorization: Bearer $token" \
        "$api/server/restartXrayService" 2>/dev/null || echo 000)"
    case "$code" in
        200) ok "xray перезапущен" ;;
        401|403) die "панель отклонила токен (HTTP $code) — нужен scope node-sync или admin" ;;
        404) die "панель ответила 404 — проверьте PANEL_URL и PANEL_BASE_PATH" ;;
        000) die "панель недоступна — проверьте PANEL_URL и что она запущена" ;;
        *) warn "панель ответила HTTP $code" ;;
    esac
}

menu() {
    local max
    max="$(menu_max)"
    while true; do
        if [ -t 1 ] && [ -z "${UISENTRY_NO_CLEAR:-}" ] && command -v clear >/dev/null 2>&1; then
            clear
        fi
        draw_menu "$(menu_status_line)"
        ask "Выберите пункт [0-$max]: "
        local choice=""
        read -r choice <&$READ_FD || choice=""
        case "$choice" in
            q|Q|"") continue ;;
        esac
        case "$choice" in
            1) cmd_status ;;
            2) cmd_show ;;
            3) cmd_logs 50 ;;
            4) menu_edit_key TELEGRAM_BOT_TOKEN ;;
            5) menu_edit_key TELEGRAM_ADMIN_IDS ;;
            6) menu_edit_key ALERT_CHAT_ID ;;
            7) menu_edit_key PANEL_URL ;;
            8) menu_edit_key PANEL_BASE_PATH ;;
            9) menu_edit_key PANEL_API_TOKEN ;;
            10) menu_pick "Сертификат панели" PANEL_VERIFY_TLS PANEL_CA_BUNDLE ;;
            11) menu_pick "Порог CPU" CPU_WARN CPU_CRIT ;;
            12) menu_pick "Порог памяти" MEM_WARN MEM_CRIT ;;
            13) menu_pick "Порог диска" DISK_WARN DISK_CRIT ;;
            14) menu_pick "Гистерезис и кулдаун" ALERT_HYSTERESIS ALERT_COOLDOWN ;;
            15) menu_edit_key EXPIRING_SOON_DAYS ;;
            16) menu_edit_key SERVICES ;;
            17) menu_edit_key LOG_LEVEL ;;
            18)
                ask "Имя ключа (uisentry-menu keys — список): "
                local key=""
                read -r key <&$READ_FD || key=""
                [ -n "$key" ] && menu_edit_key "$key"
                ;;
            19) cmd_restart ;;
            20)
                ask "Перезапустить xray в панели? [y/N] "
                local yes=""
                read -r yes <&$READ_FD || yes=""
                case "$yes" in (y|Y|yes|да) cmd_restart_xray ;; (*) info "Отменено" ;; esac
                ;;
            21) cmd_update ;;
            22)
                ask "Удалить бота? Это необратимо, введите yes: "
                local confirm=""
                read -r confirm <&$READ_FD || confirm=""
                case "$confirm" in
                    yes|YES|да)
                        cmd_uninstall
                        # Бот и само меню удалены — возвращаться некуда.
                        exit 0
                        ;;
                    *) info "Отменено" ;;
                esac
                ;;
            0) exit 0 ;;
            *) warn "Нет такого пункта: $choice (0-$max)" ;;
        esac
        if [ -t 0 ] || [ "$READ_FD" = "3" ]; then
            ask "Enter — вернуться в меню…"
            read -r _ <&$READ_FD || true
        fi
    done
}

usage() {
    cat <<EOF
${BOLD}uisentry-menu${RESET} — панель управления 3X-UI Sentry

  sudo uisentry-menu                     интерактивное меню
  sudo uisentry-menu status              состояние службы и последние ошибки
  sudo uisentry-menu show                текущие настройки (секреты замаскированы)
  uisentry-menu keys                     какие ключи разрешено менять
  uisentry-menu check KEY VALUE          проверить значение (без изменений)
  sudo uisentry-menu set KEY VALUE       изменить настройку и подсказать рестарт
  sudo uisentry-menu restart             перезапустить бота
  sudo uisentry-menu restart-xray        перезапустить xray в панели (через API)
  sudo uisentry-menu apt-logs [N]        журнал фоновых apt-обновлений
  sudo uisentry-menu totp               TOTP-секрет и otpauth (только root)
  sudo uisentry-menu logs [N]            журнал бота (по умолчанию 50 строк)
  sudo uisentry-menu update              обновить бота с GitHub
  sudo uisentry-menu uninstall [--keep-state]  удалить бота целиком (без флагов — под ноль)

Пути: PREFIX=$PREFIX, .env=$ENV_FILE

${BOLD}English${RESET}
  sudo uisentry-menu                     interactive menu
  sudo uisentry-menu status              service state and recent errors
  sudo uisentry-menu show                current settings (secrets masked)
  uisentry-menu keys                     keys that may be changed
  uisentry-menu check KEY VALUE          validate a value (no changes)
  sudo uisentry-menu set KEY VALUE       change a setting, then restart
  sudo uisentry-menu restart | logs [N]  restart the bot / show the log
  sudo uisentry-menu restart-xray        restart xray via the panel API
  sudo uisentry-menu apt-logs [N]        log of background apt upgrades
  sudo uisentry-menu totp               TOTP secret and otpauth (root only)
  sudo uisentry-menu update              update the bot from GitHub
  sudo uisentry-menu uninstall [--keep-state]  remove the bot (full cleanup by default)
  Docs: README.en.md (English) · README.md (Русский)
EOF
}

case "${1:-}" in
    ""|menu) menu ;;
    status) cmd_status ;;
    show|settings) cmd_show ;;
    keys) cmd_keys ;;
    check) cmd_check "${2:-}" "${3:-}" ;;
    set) cmd_set "${2:-}" "${3:-}" ;;
    restart) cmd_restart ;;
    restart-xray) cmd_restart_xray ;;
    apt-logs) cmd_apt_logs "${2:-80}" ;;
    totp) cmd_totp ;;
    logs) cmd_logs "${2:-50}" ;;
    update) cmd_update ;;
    uninstall|remove) cmd_uninstall "${2:-}" ;;
    help|--help|-h) usage ;;
    *) die "неизвестная команда: $1 (см. uisentry-menu --help)" ;;
esac
