# Пример правил, которые установщик кладёт в /etc/sudoers.d/uisentry-bot.
#
# Почему именно так: sudo-rs (Ubuntu 26.04+) запрещает шаблоны в аргументах
# команд («wildcards are not allowed in command arguments»), не знает алиасов
# вида User_Alias/Cmnd_Alias и части настроек Defaults. Поэтому команды
# перечисляются точно, одним правилом.
#
# Юниты установщик берёт из SERVICES, ключи команд — из COMMAND_ALLOWLIST
# (пробел заменяется на «_»).

uisentry ALL=(root) NOPASSWD: /usr/local/bin/uisentry-ctl is_active x-ui, \
    /usr/local/bin/uisentry-ctl restart_service x-ui, \
    /usr/local/bin/uisentry-ctl journal x-ui, \
    /usr/local/bin/uisentry-ctl journal_more x-ui, \
    /usr/local/bin/uisentry-ctl journal_errors x-ui, \
    /usr/local/bin/uisentry-ctl apt_update, \
    /usr/local/bin/uisentry-ctl apt_upgrade, \
    /usr/local/bin/uisentry-ctl apt_upgrade_phased, \
    /usr/local/bin/uisentry-ctl dist_upgrade, \
    /usr/local/bin/uisentry-ctl release_upgrade, \
    /usr/local/bin/uisentry-ctl apt_status update, \
    /usr/local/bin/uisentry-ctl apt_status upgrade, \
    /usr/local/bin/uisentry-ctl apt_status phased, \
    /usr/local/bin/uisentry-ctl apt_status release, \
    /usr/local/bin/uisentry-ctl reboot, \
    /usr/local/bin/uisentry-ctl run_command journalctl_--disk-usage, \
    /usr/local/bin/uisentry-ctl run_command systemctl_list-timers_--all, \
    /usr/local/bin/uisentry-ctl run_command df_-h, \
    /usr/local/bin/uisentry-ctl run_command free_-h, \
    /usr/local/bin/uisentry-ctl run_command uptime, \
    /usr/local/bin/uisentry-ctl run_command x-ui_status
