# Правила sudo для бота мониторинга.
#
# Установка (заменив имя пользователя, если оно другое):
#   sudo install -o root -g root -m 0440 xui-monitor-sudoers /etc/sudoers.d/xui-monitor
#   sudo visudo -cf /etc/sudoers.d/xui-monitor
#
# Бот работает непривилегированным и умеет только то, что перечислено ниже.
# Рестарт xray намеренно отсутствует: панель умеет делать это через API,
# и sudo для этого не нужен.

User_Alias XUI_MONITOR_USERS = xui-monitor
Cmnd_Alias XUI_MONITOR_CMNDS = \
    /usr/local/bin/xui-ctl is_active *, \
    /usr/local/bin/xui-ctl restart_service *, \
    /usr/local/bin/xui-ctl journal * *, \
    /usr/local/bin/xui-ctl journal_errors * *, \
    /usr/local/bin/xui-ctl apt_upgrade, \
    /usr/local/bin/xui-ctl apt_upgrade_phased, \
    /usr/local/bin/xui-ctl dist_upgrade, \
    /usr/local/bin/xui-ctl reboot, \
    /usr/local/bin/xui-ctl run_command *

XUI_MONITOR_USERS ALL=(root) NOPASSWD: XUI_MONITOR_CMNDS

# Defaults
# Только переносимые настройки: !requiretty на Linux не нужен (requiretty и
# так выключен), log_input для бота без терминала бессмыслен, а на новых
# сборках sudo лишние флаги ломают разбор — правила важнее.
Defaults:XUI_MONITOR_USERS log_output
