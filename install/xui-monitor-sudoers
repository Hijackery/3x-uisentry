# Пример правил, которые установщик кладёт в /etc/sudoers.d/xui-monitor-bot.
#
# Почему именно так: sudo-rs (Ubuntu 26.04+) запрещает шаблоны в аргументах
# команд («wildcards are not allowed in command arguments»), не знает алиасов
# вида User_Alias/Cmnd_Alias и части настроек Defaults. Поэтому команды
# перечисляются точно, одним правилом.
#
# Юниты установщик берёт из SERVICES, ключи команд — из COMMAND_ALLOWLIST
# (пробел заменяется на «_»).

xui-monitor ALL=(root) NOPASSWD: /usr/local/bin/xui-ctl is_active x-ui, \
    /usr/local/bin/xui-ctl restart_service x-ui, \
    /usr/local/bin/xui-ctl journal x-ui, \
    /usr/local/bin/xui-ctl journal_more x-ui, \
    /usr/local/bin/xui-ctl journal_errors x-ui, \
    /usr/local/bin/xui-ctl apt_upgrade, \
    /usr/local/bin/xui-ctl apt_upgrade_phased, \
    /usr/local/bin/xui-ctl dist_upgrade, \
    /usr/local/bin/xui-ctl reboot, \
    /usr/local/bin/xui-ctl run_command journalctl_--disk-usage, \
    /usr/local/bin/xui-ctl run_command systemctl_list-timers_--all, \
    /usr/local/bin/xui-ctl run_command df_-h, \
    /usr/local/bin/xui-ctl run_command free_-h, \
    /usr/local/bin/xui-ctl run_command uptime, \
    /usr/local/bin/xui-ctl run_command x-ui_status
