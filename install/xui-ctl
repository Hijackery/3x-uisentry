#!/usr/bin/env bash
# Единственная точка входа для привилегированных операций бота.
#
# Бот вызывает только подкоманды этого скрипта и никогда не передаёт
# произвольные строки в shell: sudo-правило в install/xui-monitor-sudoers
# разрешает ровно этот список. Аргументы здесь тоже проверяются — даже при
# ошибке в коде бота выполнить что-то незапланированное не получится.
#
# Установка:
#   sudo install -o root -g root -m 0755 xui-ctl /usr/local/bin/xui-ctl
set -euo pipefail

log() {
    logger -t xui-ctl -- "$*" 2>/dev/null || true
}

die() {
    echo "xui-ctl: $*" >&2
    exit 2
}

# expected — сколько аргументов ожидается ПОСЛЕ подкоманды.
# Вызывается как require_no_extra_args N "$@", поэтому в "$@" лежит весь
# список аргументов скрипта, начиная с самой подкоманды: её не считаем.
require_no_extra_args() {
    local expected="$1"
    shift
    [ "$(( $# - 1 ))" -eq "$expected" ] || die "неверное число аргументов"
}

safe_unit() {
    local unit="$1"
    # Только имя systemd-юнита: буквы, цифры, дефис, точка, подчёркивание.
    [[ "$unit" =~ ^[a-zA-Z0-9._@-]+$ ]] || die "недопустимое имя сервиса: $unit"
    printf '%s' "$unit"
}

safe_int() {
    local value="$1"
    [[ "$value" =~ ^[0-9]{1,6}$ ]] || die "ожидалось число: $value"
    printf '%s' "$value"
}

#: Менеджер служб выбирается по факту наличия: одна и та же обёртка работает в
#: systemd-, OpenRC- (Alpine/Gentoo) и SysV-системах.
#: Результат определённия менеджера служб (заполняет svc_backend).
SVC_KIND=""

svc_backend() {
    # SVC_BACKEND позволяет зафиксировать менеджер служб вручную: нужен для
    # тестов и для систем, где автодетект ошибается.
    if [ -n "${SVC_BACKEND:-}" ]; then
        case "$SVC_BACKEND" in
            systemd | openrc | sysv) SVC_KIND="$SVC_BACKEND"; return 0 ;;
            *) die "SVC_BACKEND=$SVC_BACKEND не поддерживается" ;;
        esac
    fi
    if command -v systemctl >/dev/null 2>&1; then
        SVC_KIND=systemd
    elif command -v rc-service >/dev/null 2>&1; then
        SVC_KIND=openrc
    elif command -v service >/dev/null 2>&1; then
        SVC_KIND=sysv
    else
        die "не найден менеджер служб (systemctl, rc-service или service)"
    fi
}

svc_restart() {
    svc_backend
    case "$SVC_KIND" in
        systemd) systemctl restart "$1" ;;
        openrc)  rc-service "$1" restart ;;
        sysv)    service "$1" restart ;;
    esac
}

svc_active() {
    svc_backend
    case "$SVC_KIND" in
        systemd) systemctl is-active --quiet "$1" ;;
        openrc)  rc-service "$1" status >/dev/null 2>&1 ;;
        sysv)    service "$1" status >/dev/null 2>&1 ;;
    esac
}

#: Логи: journalctl, если он есть, иначе — файл лога бота (его пишет сам бот).
#: Нужно для систем без systemd, где журнала нет вовсе.
svc_log() {
    local unit="$1" lines="$2" errors="${3:-0}"
    if command -v journalctl >/dev/null 2>&1; then
        if [ "$errors" = "1" ]; then
            journalctl -u "$unit" -n "$lines" --no-pager -o short-iso -p err
        else
            journalctl -u "$unit" -n "$lines" --no-pager -o short-iso
        fi
        return 0
    fi
    local file="${LOG_PATH:-/var/lib/xui-monitor/bot.log}"
    [ -f "$file" ] || die "нет journalctl и файла лога $file"
    if [ "$errors" = "1" ]; then
        grep -iE "error|critical|failed|traceback" "$file" | tail -n "$lines" || true
    else
        tail -n "$lines" "$file"
    fi
}

cmd="${1:-}"
[ -n "$cmd" ] || die "не указана подкоманда"

case "$cmd" in
    restart_service)
        require_no_extra_args 1 "$@"
        unit="$(safe_unit "$2")"
        log "restart $unit"
        if ! svc_restart "$unit"; then
            echo "Не удалось перезапустить $unit. Последние строки журнала:" >&2
            svc_log "$unit" 10 >&2 || true
            exit 1
        fi
        if ! svc_active "$unit"; then
            echo "Служба $unit запущена, но не активна — проверьте: $0 journal $unit 20" >&2
            exit 1
        fi
        echo "Сервис $unit перезапущен"
        ;;

    is_active)
        # Безопасная проверка для самопроверки установки: ничего не меняет.
        require_no_extra_args 1 "$@"
        unit="$(safe_unit "$2")"
        if svc_active "$unit"; then
            echo "active"
        else
            echo "inactive"
            exit 1
        fi
        ;;

    journal_errors)
        # Только ошибки: разбирать инцидент ночью удобнее по -p err.
        require_no_extra_args 2 "$@"
        unit="$(safe_unit "$2")"
        lines="$(safe_int "$3")"
        if [ "$lines" -lt 1 ] || [ "$lines" -gt 500 ]; then
            die "lines вне 1..500"
        fi
        svc_log "$unit" "$lines" 1 || die "не удалось прочитать журнал $unit"
        ;;

    journal_more)
        # Журнал с запасом строк. Отдельная подкоманда, а не аргумент-число:
        # sudo-rs (Ubuntu 26.04+) запрещает шаблоны в аргументах, поэтому в
        # sudoers перечисляются точные команды.
        require_no_extra_args 1 "$@"
        unit="$(safe_unit "$2")"
        svc_log "$unit" 200 0 || die "не удалось прочитать журнал $unit"
        ;;

    journal)
        require_no_extra_args 2 "$@"
        unit="$(safe_unit "$2")"
        lines="$(safe_int "$3")"
        if [ "$lines" -lt 1 ] || [ "$lines" -gt 500 ]; then
            die "lines вне 1..500"
        fi
        svc_log "$unit" "$lines" 0 || die "не удалось прочитать журнал $unit"
        ;;

    apt_upgrade)
        # Сервис бота работает с ProtectSystem=strict: его дочерние процессы
        # не могут писать в /var/lib/dpkg, /usr и /boot. Поэтому apt запускается
        # отдельным transient-юнитом — systemd создаёт для него своё окружение,
        # а бот лишь ставит задачу в очередь и сразу получает управление.
        require_no_extra_args 0 "$@"
        unit="xui-monitor-apt-upgrade"
        log "apt full-upgrade requested"

        if command -v systemctl >/dev/null 2>&1 \
            && systemctl is-active --quiet "$unit" 2>/dev/null; then
            echo "Обновление уже выполняется, следите: journalctl -u $unit"
            exit 3
        fi

        if command -v systemd-run >/dev/null 2>&1; then
            systemd-run --quiet --unit="$unit" --collect \
                --description="apt full-upgrade по команде бота" \
                --property=Type=exec \
                --property=TimeoutStartSec=3600 \
                "$0" _apt_worker ||
                die "не удалось поставить обновление в очередь"
            echo "Обновление поставлено в очередь systemd."
            echo "Следить за ходом: journalctl -u $unit -f"
        else
            # Системы без systemd: запускаем отдельной сессией, чтобы apt не
            # зависел от сервиса бота. SUDO_USER снимаем — воркер принимает
            # только прямой root-вызов.
            apt_dir="${STATE_DIR:-/var/lib/xui-monitor}"
            apt_log="$apt_dir/apt-upgrade.log"
            mkdir -p "$apt_dir" 2>/dev/null || true
            env -u SUDO_USER setsid nohup "$0" _apt_worker >>"$apt_log" 2>&1 &
            echo "Обновление запущено в фоне (без systemd)."
            echo "Лог: $apt_log"
        fi
        ;;

    _apt_worker)
        # Внутренняя подкоманда для transient-юнита. Через sudo она недостижима
        # (в sudoers её нет), а проверка SUDO_USER закрывает путь даже при
        # попытке вызвать напрямую из-под сервисного пользователя.
        [ "$(id -u)" -eq 0 ] || die "_apt_worker требует root"
        [ -z "${SUDO_USER:-}" ] || die "_apt_worker недоступен через sudo"
        require_no_extra_args 0 "$@"
        export DEBIAN_FRONTEND=noninteractive
        apt-get update
        apt-get -y -o Dpkg::Options::=--force-confdef \
            -o Dpkg::Options::=--force-confold full-upgrade
        apt-get -y autoremove
        apt-get clean
        echo "full-upgrade завершён"
        ;;

    apt_upgrade_phased)
        # Обычный upgrade, но с явно включёнными phased-обновлениями. Ubuntu
        # придерживает часть пакетов (phased rollout), из-за чего «обновлений
        # нет», хотя они есть. Отдельная подкоманда, а не флаг: бот не должен
        # уметь собирать произвольные команды apt.
        require_no_extra_args 0 "$@"
        unit="xui-monitor-apt-phased"
        log "apt upgrade (phased) requested"

        if systemctl is-active --quiet "$unit" 2>/dev/null; then
            echo "Обновление уже выполняется, следите: journalctl -u $unit"
            exit 3
        fi

        if command -v systemd-run >/dev/null 2>&1; then
            systemd-run --quiet --unit="$unit" --collect \
                --description="apt upgrade с phased-обновлениями по команде бота" \
                --property=Type=exec \
                --property=TimeoutStartSec=3600 \
                "$0" _apt_worker_phased ||
                die "не удалось поставить обновление в очередь"
            echo "Обновление поставлено в очередь systemd."
            echo "Следить за ходом: journalctl -u $unit -f"
        else
            apt_dir="${STATE_DIR:-/var/lib/xui-monitor}"
            apt_log="$apt_dir/apt-phased.log"
            mkdir -p "$apt_dir" 2>/dev/null || true
            env -u SUDO_USER setsid nohup "$0" _apt_worker_phased >>"$apt_log" 2>&1 &
            echo "Обновление (phased) запущено в фоне (без systemd)."
            echo "Лог: $apt_log"
        fi
        ;;

    _apt_worker_phased)
        # Внутренняя подкоманда для transient-юнита (см. _apt_worker).
        [ "$(id -u)" -eq 0 ] || die "_apt_worker_phased требует root"
        [ -z "${SUDO_USER:-}" ] || die "_apt_worker_phased недоступен через sudo"
        require_no_extra_args 0 "$@"
        export DEBIAN_FRONTEND=noninteractive
        apt-get update
        apt-get -y -o APT::Get::Always-Include-Phased-Updates=true upgrade
        apt-get -y autoremove
        apt-get clean
        echo "upgrade (phased) завершён"
        ;;

    dist_upgrade)
        require_no_extra_args 0 "$@"
        export DEBIAN_FRONTEND=noninteractive
        if ! command -v do-release-upgrade >/dev/null 2>&1; then
            echo "do-release-upgrade не установлен (это не Ubuntu либо пакет update-manager отсутствует)"
            exit 0
        fi
        # Шаг «Start upgrade» спрашивает подтверждение и правит конфиги в
        # интерактивном режиме. У бота нет терминала, поэтому мы только
        # проверяем доступность обновления и объясняем, что делать дальше.
        if do-release-upgrade --check-dist-upgrade-only; then
            echo "Доступно релиз-обновление (например, 22.04 -> 24.04)."
            echo "Автоматически выполнить его нельзя: do-release-upgrade требует терминала."
            echo "Выполните вручную по SSH:"
            echo "    sudo service unattended-upgrades stop"
            echo "    sudo do-release-upgrade"
            echo "После этого нажмите в боте «Перезагрузить сервер»."
            exit 0
        fi
        echo "Релиз-обновлений нет"
        ;;

    reboot)
        require_no_extra_args 0 "$@"
        log "reboot requested by monitor bot"
        sync
        # systemd выключит бота и панель штатно, без обрыва файловой системы.
        systemctl reboot
        echo "reboot отправлен"
        ;;

    run_command)
        # Ровно один аргумент: команда приходит одной строкой и сверяется со
        # списком ниже. Запускаем её как argv, без `bash -c`: shell-парсинга
        # нет вообще, поэтому даже правка allowlist не даст инъекцию.
        require_no_extra_args 1 "$@"
        command="$2"
        # Ключи (пробелы заменены на «_») — то, что перечисляет sudoers;
        # строки команд поддержаны для обратной совместимости.
        case "$command" in
            "journalctl_--disk-usage" | "journalctl --disk-usage")
                set -- journalctl --disk-usage ;;
            "systemctl_list-timers_--all" | "systemctl list-timers --all")
                set -- systemctl list-timers --all ;;
            "df_-h" | "df -h")             set -- df -h ;;
            "free_-h" | "free -h")         set -- free -h ;;
            "uptime")                      set -- uptime ;;
            "x-ui_status" | "x-ui status") set -- x-ui status ;;
            *) die "команда не разрешена: $command" ;;
        esac
        log "run allowed: $command"
        exec "$@"
        ;;

    *)
        die "неизвестная подкоманда: $cmd"
        ;;
esac
